{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jeeva Sampada",
  "mainBinaryName": "jeeva-sampada",
  "version": "1.0.0",
  "identifier": "in.ibinapps.jeevasampada",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Jeeva Sampada",
        "width": 1100,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "IBIN Apps",
    "copyright": "Jeeva Sampada (c) K.N. Ganeshaiah (proprietary right holder). Updated in 2026 by Sachin A. Rosario.",
    "category": "Education",
    "shortDescription": "Biodiversity databases of India under one roof",
    "longDescription": "Jeeva Sampada: species of plants, animals, microbes and pests of India by state and district, medicinal plant names and patents. Works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}